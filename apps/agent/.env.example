# Copy to .env for local runs. In the cloud, set these as environment secrets instead.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Optional
# AGENT_CONFIG=templates/home_services.json   # which agent config to run
# AGENT_ID=                                    # run the published version of this database agent
#                                              # (needs the Supabase keys below; dispatch metadata {"agent_id": ...} overrides)
# AGENT_NAME=                                  # set to require explicit dispatch by name
# AZURE_OPENAI_API_KEY=                        # only for provider: "azure"
# AZURE_OPENAI_ENDPOINT=

# Conversation memory (survives a dropped model session). Without these, a local
# folder is used, which only works with one worker process.
# SUPABASE_URL=https://<project-ref>.supabase.co
# SUPABASE_SECRET_KEY=            # Supabase: Project Settings > API Keys > secret key
# CONVERSATION_DIR=conversations
