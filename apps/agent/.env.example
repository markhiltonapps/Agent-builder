# Copy to .env for local runs. In the cloud, set these as environment secrets instead.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
OPENAI_API_KEY=

# Optional
# AGENT_CONFIG=templates/home_services.json   # which agent config to run
# AGENT_NAME=                                  # set to require explicit dispatch by name
# AZURE_OPENAI_API_KEY=                        # only for provider: "azure"
# AZURE_OPENAI_ENDPOINT=
